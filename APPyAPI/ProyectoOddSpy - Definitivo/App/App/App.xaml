<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:App"
             xmlns:converters="clr-namespace:App.Converters"
             x:Class="App.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="Beige" />
                <Setter Property="HasNavigationBar" Value="False" />
            </Style>

            <Style x:Key="ChipButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#40FFFFFF"/>
                <Setter Property="TextColor" Value="Black"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontFamily" Value="Inter24"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="ChipButtonSelectedStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#90FFFFFF"/>
                <Setter Property="TextColor" Value="Gray"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Inter24"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderColor" Value="White"/>
                <Setter Property="BorderWidth" Value="2"/>
            </Style>




        </ResourceDictionary>
    </Application.Resources>
</Application>