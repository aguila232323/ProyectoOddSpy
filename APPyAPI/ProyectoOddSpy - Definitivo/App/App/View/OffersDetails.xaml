<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.View.OffersDetails"
             Title="Detalle de la Promoción"
             BackgroundColor="White">

    <Grid>
        <Image Source="fondo.jpg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               ZIndex="-1"/>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">


                <Label Text="{Binding Title}"
                       FontSize="24"
                       FontAttributes="Bold"
                       FontFamily="Inter24"
                       TextColor="#001c4e"
                       HorizontalOptions="Center" />

                
                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10">


                    <Frame Padding="6,2"
                           BackgroundColor="#3E404C"
                           CornerRadius="15"
                           HasShadow="False"
                           VerticalOptions="Center">
                        <Label Text="{Binding Type}"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </Frame>

                    <Frame Padding="6,2"
                           BackgroundColor="#3E404C"
                           CornerRadius="15"
                           HasShadow="False"
                           VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="8"
                                               HorizontalOptions="Center">
                            <Image Source="logofreebets.png"
                                   HeightRequest="16"
                                   WidthRequest="16"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding MaxFreeAmount, StringFormat='{}{0}€'}"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                        </HorizontalStackLayout>
                    </Frame>

                </HorizontalStackLayout>

                <!-- Banner -->
                <Frame CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       Margin="0,10,0,0"
                       HeightRequest="200"
                       HorizontalOptions="Fill">
                    <Image Source="{Binding BannerImg}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"/>
                </Frame>

                <!-- Descripción -->
                <Label Text="{Binding Descryption}"
                       FontFamily="Inter24"
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center"/>

                <!-- Barra de Progreso -->
                <StackLayout Spacing="5" Margin="0,20,0,0">
                    <Label Text="Progreso de Liberación:"
                           FontSize="14"
                           TextColor="Gray"/>
                    <ProgressBar x:Name="progressBar"
                                 Progress="0"
                                 HeightRequest="10"
                                 BackgroundColor="#e0e0e0"
                                 ProgressColor="#ebbd34"/>
                    <Label x:Name="progressLabel"
                           Text="0 / 0"
                           FontSize="14"
                           TextColor="Black"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <!-- Botón para inscribirse -->
                <Button
                    x:Name="registerButton"
                    Text="Inscribirse"
                    BackgroundColor="#ebbd34"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    WidthRequest="150"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
                    Clicked="OnRegisterClicked" />

                <!-- Botón ya inscrito -->
                <Button
                    x:Name="alreadyRegisteredButton"
                    Text="Ya estás inscrito"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    WidthRequest="150"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
                    IsVisible="False"
                    IsEnabled="False" />



            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
