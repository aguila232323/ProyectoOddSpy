<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI"
             x:Class="App.View.ChangePasswordPage"
             Title="Cambiar Contraseña">

    <Grid>
        <Image Source="fondo.jpg"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"
               Grid.RowSpan="2"
               ZIndex="-1" />
        <ScrollView>
            <StackLayout Padding="20" Spacing="25">


                <skia:SKLottieView
                    RepeatCount="1"
                    Source="lock.json" 
                    HeightRequest="100"
                    WidthRequest="100"
                    HorizontalOptions="Center"/>

                <Label Text="Cambiar Contraseña"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <!-- Campo de contraseña -->
                <Frame BackgroundColor="#20FFFFFF"
                       CornerRadius="12"
                       Padding="20"
                       HasShadow="False"
                       BorderColor="#40FFFFFF">
                    <StackLayout Spacing="20">

                        <!-- Contraseña actual -->
                        <StackLayout Spacing="8">
                            <Label Text="CONTRASEÑA ACTUAL"
                                   FontSize="14"
                                   TextColor="White"
                                   FontAttributes="Bold"/>

                            <Frame BackgroundColor="#10FFFFFF"
                                   CornerRadius="8"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="#40FFFFFF">
                                <Entry x:Name="CurrentPasswordEntry" 
                                       IsPassword="True" 
                                       Placeholder="Ingresa tu contraseña actual"
                                       TextColor="White"
                                       FontSize="16"
                                       BackgroundColor="Transparent"
                                       Margin="12,0"/>
                            </Frame>
                        </StackLayout>

                        <!-- Nueva contraseña -->
                        <StackLayout Spacing="8">
                            <Label Text="NUEVA CONTRASEÑA"
                                   FontSize="14"
                                   TextColor="White"
                                   FontAttributes="Bold"/>

                            <Frame BackgroundColor="#10FFFFFF"
                                   CornerRadius="8"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="#40FFFFFF">
                                <Entry x:Name="NewPasswordEntry" 
                                       IsPassword="True" 
                                       Placeholder="Ingresa tu nueva contraseña"
                                       TextColor="White"
                                       FontSize="16"
                                       BackgroundColor="Transparent"
                                       Margin="12,0"/>
                            </Frame>
                        </StackLayout>

                        <!--Error -->
                        <Label x:Name="ErrorLabel" 
                               TextColor="#FF5252" 
                               IsVisible="False"
                               FontSize="14"
                               Margin="0,10,0,0"
                               HorizontalTextAlignment="Center"/>

                    </StackLayout>
                </Frame>

                <!-- Botones-->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="15"
                      Margin="0,10">
                    <Button x:Name="CancelButton"
                            Text="CANCELAR"
                            CornerRadius="8"
                            BackgroundColor="#20FFFFFF"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Clicked="OnCancelClicked"/>

                    <Button x:Name="AcceptButton"
                            Text="ACEPTAR"
                            CornerRadius="8"
                            BackgroundColor="#FBBF24"
                            TextColor="#1E3A8A"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Clicked="OnChangePasswordClicked"/>
                </Grid>

            </StackLayout>
        </ScrollView>

        <!-- Confirmación -->
        <Grid IsVisible="False"
              x:Name="ConfirmationOverlay"
              BackgroundColor="#80000000"
              Padding="20"
              VerticalOptions="Center"
              HorizontalOptions="Fill">
            <Frame BackgroundColor="#303F9F"
                   CornerRadius="12"
                   Padding="15"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="300">
                <StackLayout Spacing="10" HorizontalOptions="Center">
                    <skia:SKLottieView 
                          Source="success_animation.json"
                          RepeatCount="1"
                          HeightRequest="100"
                          WidthRequest="100"
                          HorizontalOptions="Center" />

                    <Label Text="¡Contraseña cambiada con éxito!"
                           FontSize="16"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           MaxLines="2"
                           LineBreakMode="WordWrap"/>

                    <Button Text="Aceptar"
                            BackgroundColor="#FBBF24"
                            TextColor="#1E3A8A"
                            FontAttributes="Bold"
                            CornerRadius="20"
                            HorizontalOptions="Center"
                            WidthRequest="120"
                            />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>